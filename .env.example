# Copia este archivo como .env (ignorado por git) y pon los valores de tu proyecto.
# Solo la Project URL y la publishable key (son públicas: van dentro del APK).
# NUNCA la service_role, una sb_secret_… ni el Client secret de Google.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-clave>
