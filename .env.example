# Copia este archivo como .env (ignorado por git) y pon los valores de tus proyectos.
# Solo la Project URL y la publishable key de cada proyecto (son públicas: van dentro del APK
# de su variante). NUNCA la service_role, una sb_secret_… ni el Client secret de Google.
# Producción (variante production, com.poguis.Registro):
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-clave>
# Desarrollo (variante development, com.poguis.Registro.dev → proyecto Registro Dev):
EXPO_PUBLIC_SUPABASE_DEV_URL=https://<project-ref-dev>.supabase.co
EXPO_PUBLIC_SUPABASE_DEV_PUBLISHABLE_KEY=sb_publishable_<tu-clave-dev>
